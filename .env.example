# 复制为 .env 并按环境填写；密钥类配置禁止提交。
GOIM_BIZ_ENV=dev
GOIM_BIZ_CONFIG_DIR=etc

# MySQL 与 Redis
GOIM_BIZ_MYSQL__DSN=root:devpass@tcp(127.0.0.1:3306)/goim_business?charset=utf8mb4&parseTime=True&loc=UTC
GOIM_BIZ_REDIS__ADDR=127.0.0.1:6379
GOIM_BIZ_REDIS__PASSWORD=

# JWT（生产环境必须替换为随机长密钥）
GOIM_BIZ_AUTH__JWT_SECRET=dev-only-jwt-secret-change-before-deploy
GOIM_BIZ_AUTH__COOKIE_SECURE=false
